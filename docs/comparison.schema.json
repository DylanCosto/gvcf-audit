            },
            "unsupported_allele": {
              "type": "integer",
              "minimum": 0
            },
            "complex_variant": {
              "type": "integer",
              "minimum": 0
            },
            "overlapping_records": {
              "type": "integer",
              "minimum": 0
            },
            "reference_mismatch": {
              "type": "integer",
              "minimum": 0
            },
            "reference_ambiguous": {
              "type": "integer",
              "minimum": 0
            },
            "filter_not_assessed": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "bases_by_state_delta": {
          "type": "object",
          "required": [
            "callable_reference",
            "callable_variant",
            "no_record",
            "no_call",
            "partial_no_call",
            "site_filtered",
            "genotype_filtered",
            "quality_missing",
            "low_depth",
            "low_gq",
            "unsupported_ploidy",
            "unsupported_allele",
            "complex_variant",
            "overlapping_records",
            "reference_mismatch",
            "reference_ambiguous",
            "filter_not_assessed"
          ],
          "properties": {
            "callable_reference": {
              "type": "integer"
            },
            "callable_variant": {
