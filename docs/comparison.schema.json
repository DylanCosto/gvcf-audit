            }
          },
          "additionalProperties": false
        }
      }
    },
    "contig": {
      "allOf": [
        {
          "$ref": "#/$defs/summary"
        },
        {
          "type": "object",
          "required": [
            "contig"
          ],
          "properties": {
            "contig": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "group": {
      "allOf": [
        {
          "$ref": "#/$defs/contig"
        },
        {
          "type": "object",
          "required": [
            "gene",
            "intervals"
          ],
          "properties": {
            "gene": {
              "type": "string",
              "minLength": 1
            },
            "intervals": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ]
    }
